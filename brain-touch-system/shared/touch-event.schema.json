{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/brain-touch-system/touch-event.schema.json",
  "title": "Brain Touch Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "timestamp",
    "handDetected",
    "isTouching",
    "region",
    "regionLabel",
    "surface",
    "surfaceLabel",
    "contactType",
    "distanceCm",
    "durationSec",
    "confidence",
    "debug"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1.0"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "examples": ["iphone-12-pro"]
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix time in milliseconds."
    },
    "handDetected": {
      "type": "boolean"
    },
    "isTouching": {
      "type": "boolean"
    },
    "region": {
      "type": ["string", "null"],
      "enum": [
        "left_frontal_lobe",
        "right_frontal_lobe",
        "left_parietal_lobe",
        "right_parietal_lobe",
        "left_temporal_lobe",
        "right_temporal_lobe",
        "left_occipital_lobe",
        "right_occipital_lobe",
        "cerebellum",
        "brainstem",
        "top",
        "left_side",
        "right_side",
        "front",
        "back",
        "center",
        "unknown",
        "top_front_left",
        "top_front_right",
        "top_middle_left",
        "top_middle_right",
        "top_back_left",
        "top_back_right",
        "side_lower_front_left",
        "side_lower_front_right",
        "side_lower_middle_left",
        "side_lower_middle_right",
        "side_lower_back_left",
        "side_lower_back_right",
        null
      ]
    },
    "regionLabel": {
      "type": ["string", "null"]
    },
    "surface": {
      "type": ["string", "null"],
      "enum": [
        "front",
        "back",
        "left",
        "right",
        "top",
        "bottom",
        "side",
        "center",
        "unknown",
        null
      ]
    },
    "surfaceLabel": {
      "type": ["string", "null"]
    },
    "contactType": {
      "type": "string",
      "enum": [
        "index_fingertip",
        "middle_fingertip",
        "ring_fingertip",
        "multiple_fingertips",
        "hand_palm",
        "unknown"
      ]
    },
    "distanceCm": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "durationSec": {
      "type": "number",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indexTip2D",
        "indexTip3D",
        "depthMeters",
        "fps"
      ],
      "properties": {
        "indexTip2D": {
          "$ref": "#/$defs/point2D"
        },
        "indexTip3D": {
          "$ref": "#/$defs/point3D"
        },
        "indexTip3DSpace": {
          "type": "string",
          "enum": ["arkit_world", "camera"]
        },
        "selectedFinger": {
          "type": ["string", "null"],
          "enum": ["index", "middle", "ring", null]
        },
        "selectedFingerTip3D": {
          "$ref": "#/$defs/point3D"
        },
        "selectedFingerDIP3D": {
          "$ref": "#/$defs/point3D"
        },
        "surfaceApproachAlignment": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "reprojectionErrorPixels": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "eventFps": {
          "type": "number",
          "minimum": 0
        },
        "calibrationValid": {
          "type": "boolean"
        },
        "handDetectorSource": {
          "type": "string"
        },
        "handDetectorStatus": {
          "type": "string"
        },
        "handDetectorInferenceMs": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "handLandmarks2D": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": {
            "$ref": "#/$defs/point2D"
          }
        },
        "detectedJointCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21
        },
        "fingerTips2D": {
          "type": "object",
          "additionalProperties": false,
          "required": ["thumbTip", "indexTip", "middleTip", "ringTip", "littleTip"],
          "properties": {
            "thumbTip": {
              "$ref": "#/$defs/point2D"
            },
            "indexTip": {
              "$ref": "#/$defs/point2D"
            },
            "middleTip": {
              "$ref": "#/$defs/point2D"
            },
            "ringTip": {
              "$ref": "#/$defs/point2D"
            },
            "littleTip": {
              "$ref": "#/$defs/point2D"
            }
          }
        },
        "depthMeters": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "depthSample2D": {
          "$ref": "#/$defs/point2D"
        },
        "rawImageNorm": {
          "$ref": "#/$defs/point2D"
        },
        "depthPixel": {
          "$ref": "#/$defs/pixelPoint"
        },
        "depthMapSize": {
          "$ref": "#/$defs/pixelSize"
        },
        "capturedImageSize": {
          "$ref": "#/$defs/pixelSize"
        },
        "visionOrientation": {
          "type": ["string", "null"]
        },
        "depthConfidenceRaw": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "depthSource": {
          "type": ["string", "null"],
          "enum": ["smoothedSceneDepth", "sceneDepth", "none", null]
        },
        "depthStrategy": {
          "type": ["string", "null"]
        },
        "depthSampleCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "touchCandidate": {
          "type": "boolean"
        },
        "strongTouchCandidate": {
          "type": "boolean"
        },
        "fingerSpeedMetersPerSec": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "surfaceContactProfile": {
          "$ref": "#/$defs/surfaceContactProfile"
        },
        "calibration": {
          "$ref": "#/$defs/brainCalibration"
        },
        "fps": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "point2D": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "pixelPoint": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pixelSize": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "point3D": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "surfaceContactProfile": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "modelPosition01",
        "surfaceNormal",
        "topness",
        "sideness",
        "leftness",
        "rightness",
        "frontness",
        "backness"
      ],
      "properties": {
        "modelPosition01": {
          "$ref": "#/$defs/point3D"
        },
        "surfaceNormal": {
          "$ref": "#/$defs/point3D"
        },
        "topness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sideness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "leftness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "frontness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "backness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "brainCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "centerX",
        "centerY",
        "centerZ",
        "widthMeters",
        "depthMeters",
        "heightMeters",
        "touchThresholdCm",
        "dwellTimeSeconds",
        "confidenceThreshold"
      ],
      "properties": {
        "centerX": {
          "type": "number"
        },
        "centerY": {
          "type": "number"
        },
        "centerZ": {
          "type": "number"
        },
        "widthMeters": {
          "type": "number",
          "minimum": 0.05
        },
        "depthMeters": {
          "type": "number",
          "minimum": 0.05
        },
        "heightMeters": {
          "type": "number",
          "minimum": 0.05
        },
        "meshRealWidthMeters": {
          "type": "number",
          "minimum": 0.03
        },
        "meshYawDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "touchThresholdCm": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 20
        },
        "strongTouchThresholdCm": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 20
        },
        "dwellTimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "confidenceThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "smoothingFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    }
  }
}
